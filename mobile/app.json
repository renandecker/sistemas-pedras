{
  "expo": {
    "name": "Marmoraria",
    "slug": "marmoraria-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#171412"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.marmoraria.mobile"
    },
    "android": {
      "package": "com.marmoraria.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#171412"
      }
    },
    "web": {
      "bundler": "metro"
    },
    "extra": {
      "apiBaseUrl": "http://localhost:8080/api"
    }
  }
}
